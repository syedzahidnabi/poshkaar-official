{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "framework": "vite",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/collection/:slug",
      "destination": "/collections/:slug",
      "permanent": true
    },
    {
      "source": "/product/aari1",
      "destination": "/product/aari-01",
      "permanent": true
    },
    {
      "source": "/product/aari2",
      "destination": "/product/aari-02",
      "permanent": true
    },
    {
      "source": "/product/aari3",
      "destination": "/product/aari-03",
      "permanent": true
    },
    {
      "source": "/product/aari4",
      "destination": "/product/aari-04",
      "permanent": true
    },
    {
      "source": "/product/aari5",
      "destination": "/product/aari-05",
      "permanent": true
    },
    {
      "source": "/product/aari6",
      "destination": "/product/aari-06",
      "permanent": true
    },
    {
      "source": "/product/aari7",
      "destination": "/product/aari-07",
      "permanent": true
    },
    {
      "source": "/product/aari8",
      "destination": "/product/aari-08",
      "permanent": true
    },
    {
      "source": "/product/aari9",
      "destination": "/product/aari-09",
      "permanent": true
    },
    {
      "source": "/product/tilla1",
      "destination": "/product/tilla-01",
      "permanent": true
    },
    {
      "source": "/product/tilla2",
      "destination": "/product/tilla-02",
      "permanent": true
    },
    {
      "source": "/product/tilla3",
      "destination": "/product/tilla-03",
      "permanent": true
    },
    {
      "source": "/product/tilla4",
      "destination": "/product/tilla-04",
      "permanent": true
    },
    {
      "source": "/product/tilla5",
      "destination": "/product/tilla-05",
      "permanent": true
    },
    {
      "source": "/product/tilla6",
      "destination": "/product/tilla-06",
      "permanent": true
    },
    {
      "source": "/product/tilla7",
      "destination": "/product/tilla-07",
      "permanent": true
    },
    {
      "source": "/product/tilla8",
      "destination": "/product/tilla-08",
      "permanent": true
    },
    {
      "source": "/product/zari1",
      "destination": "/product/zari-01",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/merchant-feed.xml",
      "destination": "/api/merchant-feed.xml"
    },
    {
      "source": "/:path((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
